# IndiBrick — canonical environment reference.
#
# Copy this file to `.env.local` for local dev and fill in the values you need.
# In prod, set the equivalents in Vercel / Cloud Run / Firebase Functions
# secrets. Never commit `.env.local`.
#
# Grouped by subsystem. Marked [REQUIRED] must be set for that feature to
# work at all; [OPTIONAL] can be left blank to disable the feature.


# ─── Firebase (client SDK, public) ─────────────────────────────────
# The client SDK config. Public — safe to expose in the browser bundle.
# Values come from Firebase Console → Project Settings → General → Your apps.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=indibrick-web           # [REQUIRED]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=indibrick-web.appspot.com   # [OPTIONAL] fallback path


# ─── Firebase Admin (server-side, private) ─────────────────────────
# Service-account credentials the API routes use to bypass Firestore
# rules for internal reads/writes. NEVER expose these.
# Generate at Firebase Console → Project Settings → Service accounts →
# Generate new private key. Copy client_email + private_key from the JSON.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com   # [REQUIRED]
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"   # [REQUIRED — escape newlines as \n]
FIREBASE_STORAGE_BUCKET=indibrick-web.appspot.com       # [OPTIONAL]


# ─── Gemini / Google AI ────────────────────────────────────────────
# Powers AI Deal Analyzer, AI Intake wizard, Copilot, RAG intake.
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                                          # [REQUIRED for AI features]
GOOGLE_GENERATIVE_AI_API_KEY=                            # [OPTIONAL fallback name]


# ─── Google OAuth (Google Calendar sync) ───────────────────────────
# Powers the per-user Google Calendar OAuth flow.
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=                                  # [REQUIRED for calendar sync]
GOOGLE_OAUTH_CLIENT_SECRET=                              # [REQUIRED for calendar sync]
GOOGLE_OAUTH_REDIRECT_URI=https://indibrick.ca/api/partner/calendar-oauth/callback


# ─── Google Service Account (server-to-server) ─────────────────────
# Separate from the OAuth flow — used for admin-scoped Calendar/Drive
# operations that don't tie to a specific user.
GOOGLE_CLIENT_EMAIL=                                     # [OPTIONAL]
GOOGLE_PRIVATE_KEY=                                      # [OPTIONAL — same \n escape rules]


# ─── Twilio (SMS + voice) ──────────────────────────────────────────
# See docs/twilio-setup.md for full walkthrough. Wave 1 comms wiring
# is complete on the app side; setting these turns it on.
TWILIO_ACCOUNT_SID=                                      # [OPTIONAL — leaving blank disables SMS/call]
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14165551234                         # E.164
TWILIO_WEBHOOK_BASE_URL=https://indibrick.ca             # For localhost use ngrok URL
TWILIO_SKIP_SIGNATURE=                                   # Set to "1" only in dev (bypass signature check)
#
# ─── Browser dialer (optional; agents can choose per call) ─────────
# Without all three, the CRM still calls agents on their handset — it
# just stops offering the browser option. Nothing breaks.
#
# Why a separate credential pair: the browser authenticates with a
# short-lived JWT signed by an API Key, NOT the Auth Token. An API key
# can be revoked on its own, so a leaked browser token costs one key
# rather than the account. Never sign these with TWILIO_AUTH_TOKEN.
#
# Setup:
#   1. Console → Account → API keys & tokens → Create standard key.
#      The secret is shown once and is not recoverable.
#   2. Console → Voice → TwiML Apps → Create.
#      Voice request URL: https://indibrick.ca/api/twilio/voice-browser
#   3. Copy the App SID (APxxx) below.
#
# Cost: a browser leg bills at roughly a third of ringing a handset.
TWILIO_API_KEY_SID=                                      # SKxxxxxxxx
TWILIO_API_KEY_SECRET=                                   # shown once at creation
TWILIO_TWIML_APP_SID=                                    # APxxxxxxxx


# ─── Cloudflare Turnstile (form CAPTCHA) ───────────────────────────
# Free, GDPR-friendly bot protection on public forms. Get keys at
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=                                    # [OPTIONAL — leaving blank makes form CAPTCHA a no-op]
TURNSTILE_SITE_KEY=                                      # (Server-side reference)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                          # (Same key; exposed to browser for widget render)


# ─── Meta Lead Ads (webhook receiver) ──────────────────────────────
# Powers the Facebook Lead Ads → CRM flow in metaLeadReceiver Cloud
# Function. Rotate if your token leaks.
META_ACCESS_TOKEN=                                       # [OPTIONAL — needed only for Meta Lead Ads]


# ─── Workflow webhook signing ──────────────────────────────────────
# When set, outbound webhook actions (from the workflow builder) sign
# their payloads with HMAC-SHA256. Receivers verify with the same key.
WEBHOOK_SIGNING_SECRET=                                  # [OPTIONAL]


# ─── Unsubscribe token signing (Wave E-2) ──────────────────────────
# Every campaign email carries a signed one-click unsubscribe URL.
# Required in prod — a dev fallback secret is used when unset which
# logs a warning + is unsafe. Rotate ONLY when you're OK invalidating
# in-flight unsub links from historical sends.
UNSUBSCRIBE_SIGNING_SECRET=                              # [REQUIRED in prod]


# ─── Google Business Profile (live review rating) ──────────────────
# Feeds the real star rating + review count into the TrustBar strip via
# lib/googleReviews.ts. Without BOTH of these the review badge stays
# hidden and the strip falls back to the FSRA credential — which is the
# correct behaviour, never a reason to hardcode a rating.
#
# Setup:
#   1. Google Cloud Console -> enable "Places API (New)".
#   2. Create an API key, restrict it to Places API (New). Server-side
#      only, so restrict by IP — NOT by HTTP referrer.
#   3. Find your Place ID:
#      https://developers.google.com/maps/documentation/places/web-service/place-id
#
# Cost: one request per 12-hour revalidation window, ~2/day. Free tier.
GOOGLE_PLACES_API_KEY=                                   # [OPTIONAL — unlocks live review badge]
GOOGLE_PLACE_ID=                                         # [OPTIONAL — the business's Google Place ID]

# ─── Repliers (MLS / listings data) ────────────────────────────────
# For the public listings + market pages. Not needed for the partner CRM.
# Powers real MLS inventory (active listing counts, median DOM, median
# list price) on the /real-estate/* matrix via lib/repliersClient.ts.
# Without it those figures are omitted entirely — never estimated.
#
# This is the single highest-impact SEO unlock available: CREA's HPI is
# one benchmark per REGION, so 41 cities currently collapse to 12
# distinct numbers. City-level inventory is what makes city-level pages
# defensible instead of near-duplicate.
#
# Setup: sign up at repliers.com, complete the CREA/TRREB data agreement
# (a commercial agreement, not just a key), then confirm your board
# permits PUBLIC display of aggregate counts. The client only exposes
# aggregates for that reason — per-listing display is usually restricted
# to authenticated IDX/VOW surfaces.
REPLIERS_API_KEY=                                        # [OPTIONAL — unlocks city-level market data]


# ─── Admin OTP (temporary auth bypass) ─────────────────────────────
# Legacy — used only on a couple of admin pages predating the auth
# guard. Being phased out. Do not rely on it for new work.
NEXT_PUBLIC_ADMIN_OTP=                                   # [OPTIONAL]
ADMIN_SECRET_KEY=                                        # [OPTIONAL]


# ─── Feature flags ─────────────────────────────────────────────────
# Runtime toggles that don't require a redeploy of shared config.
NEXT_PUBLIC_INSURANCE_ROLE_ENABLED=true                  # false = hide insurance tab


# ─── Site config ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://indibrick.ca                # Absolute base for canonical URLs


# ─── Observability (Wave D — Sentry) ───────────────────────────────
# Get DSN from https://sentry.io → Project Settings → Client Keys.
# Leave blank in dev; set in prod so errors get surfaced.
NEXT_PUBLIC_SENTRY_DSN=                                  # [OPTIONAL — both client + server report to it]
SENTRY_ORG=                                              # [OPTIONAL — for source-map upload]
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                                       # [OPTIONAL — for source-map upload]


# ─── SEO OS (Phase 0+) ─────────────────────────────────────────────
# In-house replacement for Uplift AI — content engine, calendar,
# audit, backlink research, publishing, and AI-citation tracking.
#
# Anthropic key powers content generation (Phase 1.1), calendar
# generation (Phase 1.2), audit AEO checks (Phase 1.3), and the
# Claude arm of the citation tracker (Phase 3).
ANTHROPIC_API_KEY=                                       # [REQUIRED for Phase 1 onward]
#
# Integration credential encryption. Prefer Cloud KMS in prod:
# set KMS_KEY_NAME to a fully-qualified key resource
# (projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY)
# and install @google-cloud/kms. Falls back to local AES-256-GCM
# if unset — that path uses INTEGRATION_ENCRYPTION_SECRET.
KMS_KEY_NAME=                                            # [PROD RECOMMENDED — else AES fallback]
INTEGRATION_ENCRYPTION_SECRET=                           # base64 32-byte AES-256 key; dev fallback used if unset
#
# Phase 3 citation-tracker keys — add when Phase 3 turns on.
PERPLEXITY_API_KEY=                                      # [Phase 3 — most reliable citation source]
OPENAI_API_KEY=                                          # [Phase 3 — ChatGPT arm]
GEMINI_API_KEY=                                          # [Phase 3 — Gemini w/ grounding]
SERP_API_KEY=                                            # [Phase 3 OPTIONAL — Google AI Overviews scrape ($$)]
SERP_API_PROVIDER=serpapi                                # [Phase 3] serpapi | dataforseo — default serpapi
CITATION_TRACKER_SECRET=                                 # [Phase 3 REQUIRED for Cloud Scheduler] Bearer token the scheduler sends


# ─── Node / build ──────────────────────────────────────────────────
# NODE_ENV is set automatically by Next / Vercel; listed for reference.
# NODE_ENV=development | production | test
