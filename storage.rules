rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public marketing images — anyone can view (so they render on the site),
    // only signed-in users can upload (admin uploads from portal-x-99).
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /listings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private client document vault — all reads/writes happen server-side via the
    // Firebase Admin SDK (which bypasses these rules), so deny direct client access.
    match /vault/{allPaths=**} {
      allow read, write: if false;
    }

    // Lock everything else down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
